rules_version = '2';

// ระบบใหม่บน Firebase: สมุดสต๊อก (ขั้น 1 ตัวสมุด · ขั้น 2 รายชื่อคนใช้ ตัวนับโควตา · ขั้น 3 เลข TRcloud ยอด TRcloud ชีตเดิม)
// กฎชุดเดียวกับ rulesError() ใน public/wms-fire.js (store จำลองเช็คแบบนี้ เทสต์อยู่ใน src/data/fire.test.js)
//
// ก่อนใช้จริง: เปลี่ยน example[.]com ในฟังก์ชัน signedIn() เป็นโดเมนอีเมลบริษัท (จุดเขียนเป็น [.])
// วางใน Firebase Console > Firestore Database > Rules แล้วกด Publish
//
// ที่เก็บ
//   users/{อีเมลตัวเล็ก}  {name, role: head | staff | viewer, active, last, by, at}  หัวหน้าเพิ่มชื่อในหน้าตั้งค่า
//   use/{วันแปซิฟิก}      {รหัสเครื่อง: {r, w, by}}  ตัวนับโควตา แต่ละเครื่องส่งยอดของตัวเองชั่วโมงละครั้ง
//   meta/head            {v, seq, month, next, last, rows, open, mv, tv, trc, at}  ทุกการบันทึกเขียนตัวนี้ จึงเรียงกันทีละชุด
//                        tv = รุ่นเลข TRcloud (ใส่เลขแล้ว +1) · trc = 'วันที่#รุ่น' ยอด TRcloud ล่าสุด · mv = รุ่นตารางหลัก
//   docs/{รหัสชุด}         กดบันทึก 1 ครั้ง = 1 เอกสาร สร้างได้อย่างเดียว แก้ได้เฉพาะเลข TRcloud (tr trState trBy trAt) ลบไม่ได้
//   docs/{รหัสชุด}~2, ~3  ส่วนแยกของเอกสารใหญ่ ต้องมาในคำขอเดียวกับเอกสารหลัก
//   master/{conv|sup|cap} ตารางแปลงสินค้า Supplier ความจุ หัวหน้าแก้
//   trc/{วันที่}           ยอดคงเหลือ TRcloud ที่นำเข้า (Stock WH-Loss ราคาทุน) หัวหน้าแก้
//   xfer/log             {วันที่: {by, at, n, last}} วางแถวลงชีต Transaction เดิมแล้ว (ช่วงเปลี่ยนผ่าน) แก้ครั้งละวัน
//   ที่อื่นทั้งหมด = ปฏิเสธ
//
// Rules อ่านเอกสารประกอบ (get / getAfter / exists) ได้ไม่เกิน 10 ครั้งต่อการเขียนเอกสารเดียว
// และ 20 ครั้งต่อ transaction หรือ batch นับรวมทุกเอกสาร จึงออกแบบให้ใช้น้อย:
//   docs สร้างใหม่ (หลักหรือส่วนแยก)  2  = users + getAfter(meta/head)
//   meta/head seq +1                2  = users + getAfter(docs/{last})
//   อื่น ๆ                           1  = users (ใส่เลข TRcloud ครั้งละไม่เกิน 10 เอกสาร + meta = 11)
//   บันทึกหนึ่งชุด = 4 + 2 ต่อส่วนแยก แอปจำกัดไม่เกิน 7 ส่วน (PARTS_MAX) = 16

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@example[.]com');
    }
    function email() { return request.auth.token.email.lower(); }
    function profile() { return get(/databases/$(database)/documents/users/$(email())).data; }
    function metaAfter() { return getAfter(/databases/$(database)/documents/meta/head).data; }

    function isActive(u) { return u.active == true; }
    function isStaff(u) { return u.active == true && (u.role == 'staff' || u.role == 'head'); }
    function isHead(u) { return u.active == true && u.role == 'head'; }

    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function pad4(n) { return n < 10 ? '000' + string(n) : n < 100 ? '00' + string(n) : n < 1000 ? '0' + string(n) : string(n); }
    /** เดือนของเลขเอกสาร 'yyMM' ตามเวลาไทยของเซิร์ฟเวอร์ (ไม่เชื่อนาฬิกาเครื่อง) */
    function thaiMonth() {
      let t = request.time + duration.value(7, 'h');
      return pad2(t.year() % 100) + pad2(t.month());
    }

    /* ── เอกสาร ── */

    /** เอกสารหลัก: meta.last = เอกสารนี้ แปลว่า meta ถูกเขียนในคำขอเดียวกัน (เอกสารเดิมสร้างซ้ำไม่ได้) */
    function mainOk(id, d, u, m) {
      return m.seq == d.seq && m.last == id
        && d.by == email() && d.at == request.time
        && ((d.type in ['ตารางเดิม', 'ยอดยกมา', 'ปรับยอด', 'กลับรายการ']) ? (u.role == 'head')
          : (d.type in ['ตัดขาย', 'ย้าย', 'คืน', 'รับของ', 'แปลง']))
        && m.month == thaiMonth() && d.no == 'T' + m.month + '-' + pad4(m.next - 1);
    }
    /** ส่วนแยก: meta.at = เวลาของคำขอนี้ แปลว่า meta เพิ่ง seq +1 ในคำขอนี้ ไม่ใช่เติมส่วนให้เอกสารเก่าทีหลัง */
    function partOk(id, d, m) {
      return m.at == request.time && m.last == d.of && m.seq == d.seq && id == d.of + '~' + string(d.i)
        && d.keys().hasOnly(['v', 'of', 'seq', 'i', 'rows', 'orders']);
    }
    function docCreate(id, d, u, m) {
      return isStaff(u) && (('of' in d) ? partOk(id, d, m) : mainOk(id, d, u, m));
    }
    /** ใส่เลข TRcloud ทีหลัง: แก้ได้แค่ 4 ช่องนี้ เวลาเป็นของเซิร์ฟเวอร์ สถานะ รอลง / ลงแล้ว / ไม่ต้องลง */
    function trUpdate(d, old, u) {
      return isStaff(u) && d.diff(old).affectedKeys().hasOnly(['tr', 'trState', 'trBy', 'trAt']) && d.trBy == email()
        && d.trAt == request.time && d.trState in ['wait', 'done', 'none'] && d.tr is string && d.tr.size() <= 100;
    }

    match /docs/{id} {
      allow read: if signedIn() && isActive(profile());
      allow create: if signedIn() && docCreate(id, request.resource.data, profile(), metaAfter());
      allow update: if signedIn() && trUpdate(request.resource.data, resource.data, profile());
    }

    /* ── meta/head ── */

    /** seq +1 มากับเอกสารใหม่ seq เดียวกัน เลขถัดไปเริ่ม 1 ทุกเดือน */
    function metaBump(d, old, u) {
      let prevSeq = old == null ? 0 : old.seq;
      let prevNext = old != null && old.month == thaiMonth() ? old.next : 1;
      return isStaff(u) && d.seq == prevSeq + 1 && d.at == request.time
        && d.month == thaiMonth() && d.next == prevNext + 1
        && d.get('mv', 0) == (old == null ? 0 : old.get('mv', 0))
        && d.get('tv', 0) == (old == null ? 0 : old.get('tv', 0))
        && d.get('trc', '') == (old == null ? '' : old.get('trc', ''))
        && getAfter(/databases/$(database)/documents/docs/$(d.last)).data.seq == d.seq;
    }
    /** หัวหน้าเปลี่ยน master (mv +1) หรือนำเข้ายอด TRcloud (trc) ให้ทุกเครื่องดึงใหม่ แก้อย่างอื่นไม่ได้ */
    function metaMv(d, old, u) {
      return isHead(u) && d.diff(old).affectedKeys().hasOnly(['mv', 'trc']);
    }
    /** ใส่เลข TRcloud แล้ว tv +1 ให้เครื่องอื่นดึงเลขใหม่ (ทุกคนที่ลงรายการได้) */
    function metaTv(d, old, u) {
      return isStaff(u) && d.diff(old).affectedKeys().hasOnly(['tv']) && d.tv == (('tv' in old) ? old.tv : 0) + 1;
    }

    match /meta/{id} {
      allow read: if signedIn() && isActive(profile());
      allow create: if signedIn() && id == 'head' && metaBump(request.resource.data, null, profile());
      allow update: if signedIn() && id == 'head'
        && (request.resource.data.seq != resource.data.seq
          ? metaBump(request.resource.data, resource.data, profile())
          : (metaTv(request.resource.data, resource.data, profile()) || metaMv(request.resource.data, resource.data, profile())));
    }

    /* ── รายชื่อ ตารางหลัก ไฟล์ TRcloud ── */

    /** รายชื่อ: อ่านของตัวเองได้ (ตอนเข้า) ดูทั้งรายชื่อได้เฉพาะหัวหน้า · ทุกคนแก้ได้แค่เวลาเข้าล่าสุดของตัวเอง */
    match /users/{e} {
      allow get: if signedIn() && (e == email() || isActive(profile()));
      allow list: if signedIn() && isHead(profile());
      allow create, delete: if signedIn() && isHead(profile());
      allow update: if signedIn() && (isHead(profile())
        || (e == email() && isActive(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
          && request.resource.data.last == request.time));
    }
    /** ยอดอ่าน/เขียนรายวัน (ตัวนับโควตา) แต่ละเครื่องเติมช่องของตัวเอง ครั้งละช่องเดียว */
    match /use/{day} {
      allow read: if signedIn() && isActive(profile());
      allow create: if signedIn() && isActive(profile()) && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().size() == 1;
      allow update: if signedIn() && isActive(profile())
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1;
    }
    match /master/{n} {
      allow read: if signedIn() && isActive(profile());
      allow write: if signedIn() && isHead(profile());
    }
    match /trc/{d} {
      allow read: if signedIn() && isActive(profile());
      allow write: if signedIn() && isHead(profile());
    }
    /** วางแถวลงชีตเดิมแล้ว (ช่วงเปลี่ยนผ่าน) ครั้งละวันเดียว */
    match /xfer/{id} {
      allow read: if signedIn() && isActive(profile());
      allow create: if signedIn() && isStaff(profile()) && id == 'log' && request.resource.data.keys().size() == 1;
      allow update: if signedIn() && isStaff(profile()) && id == 'log'
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1;
    }
  }
}
